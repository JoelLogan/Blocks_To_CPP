<!-- The Windows application manifest of every executable of the desktop crate (build.rs).
     tools/check-windows-manifest.ps1 checks both entries in the built executable.
     No XML declaration: with MinGW, tauri-winres writes every line of this file into the resource
     file after a space, and a declaration after whitespace is not well-formed XML, which manifest
     parsers reject. The MSVC linker writes its own declaration when it merges this file. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Common Controls v6, which the native dialogs need (TaskDialogIndirect). -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
  <!-- Paths longer than MAX_PATH (260 characters) work without the \\?\ prefix where the
       system allows it (LongPathsEnabled), docs/spec/08-security.md section 8.6. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>

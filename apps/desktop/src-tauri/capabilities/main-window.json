{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "What the editor window may call in the backend: exactly one allow permission per command of the IPC contract (crates/b2c-ipc), and no core, plugin, dialog, fs, shell, http, process or opener permission (docs/spec/08-security.md §8.8).",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-app-subscribe",
    "allow-app-quit",
    "allow-project-new",
    "allow-project-open-dialog",
    "allow-project-open-recent",
    "allow-project-reload",
    "allow-project-save",
    "allow-project-save-as-dialog",
    "allow-project-close",
    "allow-project-set-dirty",
    "allow-recent-list",
    "allow-recent-remove",
    "allow-recovery-save",
    "allow-recovery-list",
    "allow-recovery-restore",
    "allow-recovery-discard",
    "allow-trust-get",
    "allow-trust-grant",
    "allow-trust-revoke",
    "allow-toolchain-list",
    "allow-toolchain-rescan",
    "allow-toolchain-add-dialog",
    "allow-toolchain-select",
    "allow-toolchain-setup-info",
    "allow-build-start",
    "allow-build-cancel",
    "allow-build-cache-clear",
    "allow-run-start",
    "allow-run-input",
    "allow-run-resize",
    "allow-run-stop",
    "allow-run-ack",
    "allow-settings-get",
    "allow-settings-update",
    "allow-open-help-link"
  ]
}

{
  "name": "@blocks2cpp/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Blocks2Cpp desktop app: a React + Blockly frontend in a Tauri 2 shell",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",

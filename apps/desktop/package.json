{
  "name": "@blocks2cpp/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Blocks2Cpp desktop app: a React + Blockly frontend in a Tauri 2 shell",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && pnpm run test:isolation",
    "test:coverage": "vitest run --coverage && pnpm run test:isolation",
    "test:isolation": "node --test --test-reporter=spec \"src-tauri/isolation-tests/*.test.js\"",
    "test:watch": "vitest",
    "e2e": "vitest run --config e2e/vitest.e2e.config.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@blockly/continuous-toolbox": "13.3.0",
    "@blocks2cpp/b2c-core-wasm": "workspace:*",
    "@blocks2cpp/blockly-ext": "workspace:*",
    "@blocks2cpp/ipc-types": "workspace:*",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tauri-apps/api": "2.12.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "blockly": "13.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/selenium-webdriver": "4.35.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "happy-dom": "20.14.5",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "selenium-webdriver": "4.50.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}

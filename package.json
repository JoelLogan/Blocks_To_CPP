{
  "name": "blocks2cpp",
  "private": true,
  "description": "Blocks2Cpp monorepo root",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "site:build": "pnpm --filter @blocks2cpp/site run build",
    "desktop:dev": "pnpm --filter @blocks2cpp/desktop run tauri dev",
    "desktop:build": "pnpm --filter @blocks2cpp/desktop run tauri build",
    "desktop:check": "pnpm --filter @blocks2cpp/desktop run typecheck && pnpm --filter @blocks2cpp/desktop run lint && pnpm --filter @blocks2cpp/desktop run format:check"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.3"
  }
}

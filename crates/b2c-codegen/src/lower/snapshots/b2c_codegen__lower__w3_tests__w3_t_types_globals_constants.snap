#include <ostream>
#include <string>

#include "kinds.hpp"

namespace {

constexpr int kBase = 40;

int rank(int v);

}  // namespace

const int kTop = kBase + 2;

std::ostream& operator<<(std::ostream& out, Colour value) {
    switch (value) {
        case Colour::Red:
            return out << "Red";
        case Colour::Green:
            return out << "Green";
    }
    return out;
}

namespace b2c {

std::string to_text(Colour value) {
    switch (value) {
        case Colour::Red:
            return "Red";
        case Colour::Green:
            return "Green";
    }
    return "";
}

}  // namespace b2c

int made = 42;

namespace {

int spare = made + 1;

}  // namespace

namespace {

int rank(int v) {
    switch (v) {
        case kTop: {
            return spare;
        }
    }
    return 0;
}

}  // namespace

int count_tags() {
    return rank(made);
}


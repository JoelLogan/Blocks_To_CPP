#include <iostream>
#include <string>
#include <vector>

#include "cards.hpp"
#include "kinds.hpp"

int main() {
    Tag t = Tag{Colour::Green, 3};
    Card c{};
    std::cout << t << '\n';
    std::cout << std::string("colour ") + b2c::to_text(t.colour) << '\n';
    std::cout << c.limit << " " << count_tags() << " " << made << '\n';
    std::vector<Tag> tags = {t};
    std::cout << tally(tags) << '\n';
    return 0;
}


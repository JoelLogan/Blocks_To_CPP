// Generated by Blocks2Cpp 1.0.0 from project "Colours", module "main".
// Edit the blocks, not this file – changes here are overwritten.

#include <iostream>
#include <string>

#include "b2c_support.hpp"

namespace {

enum class Colour { Red, Green };

}  // namespace

namespace b2c {

inline std::string to_text(Colour value) {
    switch (value) {
        case Colour::Red:
            return "Red";
        case Colour::Green:
            return "Green";
    }
    return "";
}

}  // namespace b2c

namespace {

std::string describe(Colour colour);

}  // namespace

namespace {

std::string describe(Colour colour) {
    return std::string("colour ") + b2c::to_text(colour);
}

}  // namespace

int main() {
    int n = 0;
    n = b2c::ask<int>("Number? ");
    std::cout << describe(Colour::Green) << " " << n << '\n';
    return 0;
}


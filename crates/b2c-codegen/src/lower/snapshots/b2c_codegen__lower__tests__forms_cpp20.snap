struct Student {
    std::string name{};
    int mark{};
    Color color{};
    bool passed{};
    double average{};

    auto operator<=>(const Student&) const = default;

    friend std::ostream& operator<<(std::ostream& out, const Student& value) {
        out << "Student{name: " << value.name << ", mark: " << value.mark << ", color: "
            << value.color << ", passed: " << (value.passed ? "true" : "false") << ", average: "
            << value.average << "}";
        return out;
    }
};

struct Empty {
    auto operator<=>(const Empty&) const = default;

    friend std::ostream& operator<<(std::ostream& out, const Empty&) {
        out << "Empty{}";
        return out;
    }
};


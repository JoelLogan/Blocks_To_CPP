enum class Color { Red, Green, Blue };

std::ostream& operator<<(std::ostream& out, Color value) {
    switch (value) {
        case Color::Red:
            return out << "Red";
        case Color::Green:
            return out << "Green";
        case Color::Blue:
            return out << "Blue";
    }
    return out;
}

std::string to_string(Color value) {
    switch (value) {
        case Color::Red:
            return "Red";
        case Color::Green:
            return "Green";
        case Color::Blue:
            return "Blue";
    }
    return "";
}


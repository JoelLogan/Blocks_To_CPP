    ages["Ann"] = 30;
    ages["Bob"] = 25;
    std::cout << ages.at("Bob") << " " << (ages.contains("Ann") ? "true" : "false") << '\n';
    ages.erase("Bob");
    for (const auto& [key, value] : ages) {
        std::cout << key << " " << value << '\n';
    }
    std::queue<int> waiting{};
    waiting.push(1);
    waiting.push(2);
    waiting.pop();
    std::cout << waiting.front() << '\n';
    waiting = {};

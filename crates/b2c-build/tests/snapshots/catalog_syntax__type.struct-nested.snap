#include <iostream>
#include <ostream>
#include <vector>

enum class Colour { Red, Green };

std::ostream& operator<<(std::ostream& out, Colour value) {
    switch (value) {
        case Colour::Red:
            return out << "Red";
        case Colour::Green:
            return out << "Green";
    }
    return out;
}

struct Point {
    int x{};
    double y{};
    Colour colour{};
    std::vector<Point> near{};
};

int main() {
    Point p = Point{.x = 1, .y = 2.5};
    std::cout << p.colour << '\n';
    return 0;
}

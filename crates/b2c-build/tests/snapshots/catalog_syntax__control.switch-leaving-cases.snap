    int x = 0;
    for (int i = 0; i < 10; ++i) {
        switch (x) {
            case 0: {
                continue;
            }
            case 1: {
                return 0;
            }
            case 2: {
                ++x;
                break;
            }
            default: {
            }
        }
    }
    return 0;
}

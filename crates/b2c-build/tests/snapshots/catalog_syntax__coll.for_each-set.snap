#include <iostream>
#include <set>
#include <string>

int main() {
    std::set<std::string> c{};
    for (const auto& item : c) {
        std::cout << item << '\n';
    }
    std::cout << static_cast<int>(c.size()) << '\n';
    return 0;
}

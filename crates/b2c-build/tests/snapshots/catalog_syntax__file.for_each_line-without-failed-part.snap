#include <fstream>
#include <iostream>
#include <string>

int main() {
    {
        std::ifstream b2c_file("data.txt");
        std::string line{};
        while (std::getline(b2c_file, line)) {
            std::cout << line << '\n';
        }
    }
    return 0;
}

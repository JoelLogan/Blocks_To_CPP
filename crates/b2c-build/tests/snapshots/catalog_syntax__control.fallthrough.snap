#include <iostream>

int main() {
    int x = 0;
    switch (x) {
        case 1: {
            std::cout << x << '\n';
            [[fallthrough]];
        }
        case 2: {
            std::cout << x << '\n';
            break;
        }
    }
    return 0;
}

#include <fstream>
#include <iostream>
#include <string>

int main() {
    {
        std::ifstream b2c_file("names.txt");
        std::string line{};
        while (std::getline(b2c_file, line)) {
            {
                std::ifstream b2c_file2("words.txt");
                std::string word{};
                while (std::getline(b2c_file2, word)) {
                    std::cout << static_cast<int>(word.size()) << '\n';
                }
            }
        }
    }
    return 0;
}

// Generated by Blocks2Cpp [version] from project "Catalog block type.struct-comparable-printable", module "main".
// Edit the blocks, not this file – changes here are overwritten.

#include <compare>
#include <iostream>
#include <ostream>

struct Point {
    int x{};
    double y{};

    auto operator<=>(const Point&) const = default;

    friend std::ostream& operator<<(std::ostream& out, const Point& value) {
        out << "Point{x: " << value.x << ", y: " << value.y << "}";
        return out;
    }
};

int main() {
    Point p = Point{.x = 1, .y = 2.5};
    std::cout << p << '\n';
    std::cout << (p < p ? "true" : "false") << '\n';
    return 0;
}

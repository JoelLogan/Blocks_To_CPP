#include <iostream>
#include <map>
#include <string>

int main() {
    std::map<std::string, int> c{};
    for (const auto& [key, value] : c) {
        std::cout << key << value << '\n';
    }
    std::cout << static_cast<int>(c.size()) << '\n';

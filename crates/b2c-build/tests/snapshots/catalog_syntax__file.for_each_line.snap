#include <fstream>
#include <iostream>
#include <string>

int main() {
    {
        std::ifstream b2c_file("data.txt");
        if (!b2c_file) {
            std::cerr << "Cannot open data.txt" << '\n';
            return 1;
        }
        std::string line{};
        while (std::getline(b2c_file, line)) {
            std::cout << line << '\n';
        }
    }
    return 0;
}

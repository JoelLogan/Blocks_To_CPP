Blockly 12.5.1: draw again only the blocks whose shape an edit can change, and
list a block's descendants without recursion.

The patch of Blocks2Cpp's render-management spike (P-3 in
docs/plans/m2-polish-plan.md), against Blockly 12.5.1's TypeScript sources
(core/block.ts and core/render_management.ts, as the npm package's source map
gives them). The report beside this file, blockly-render-management.md,
explains it and gives the measurements. The same change in the npm package's
bundle, as it was measured, is blockly-render-management.bundle.patch.

Blocks2Cpp does not apply it: a reviewed pnpm patch is M3-2 (ADR-0014).

To apply it to the 12.5.1 sources: patch -p1 < blockly-render-management.patch

diff --git a/core/block.ts b/core/block.ts
index 4c8f808..ed8314c 100644
--- a/core/block.ts
+++ b/core/block.ts
@@ -783,12 +783,19 @@ export class Block {
    * @returns Flattened array of blocks.
    */
   getDescendants(ordered: boolean): this[] {
-    const blocks = [this];
-    const childBlocks = this.getChildren(ordered);
-    for (let child, i = 0; (child = childBlocks[i]); i++) {
-      // AnyDuringMigration because:  Argument of type 'Block[]' is not
-      // assignable to parameter of type 'this[]'.
-      blocks.push(...(child.getDescendants(ordered) as AnyDuringMigration));
+    // Walk the tree with a stack of its own, in the same order as a recursive
+    // walk: a block's next block is one of its children, so recursion went as
+    // deep as a stack of statements is long, and copying each child's list
+    // into its parent's took time quadratic in that length.
+    const blocks: this[] = [];
+    const pending: this[] = [this];
+    let block: this | undefined;
+    while ((block = pending.pop())) {
+      blocks.push(block);
+      const childBlocks = block.getChildren(ordered) as this[];
+      for (let i = childBlocks.length - 1; i >= 0; i--) {
+        pending.push(childBlocks[i]);
+      }
     }
     return blocks;
   }

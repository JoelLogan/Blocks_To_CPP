+
+/**
+ * Updates the locations of the components (connections, icons, fields) of
+ * every block that may have moved in this render: each block that was drawn
+ * again and every block below it. A dirty block that was not drawn again kept
+ * its shape and where its children are, so only its dirty children can have
+ * changed.
+ *
+ * @param block The dirty block to start from.
+ * @param blockOrigin The top-left of the block in workspace coordinates.
+ */
+function updateComponentLocations(block: BlockSvg, blockOrigin: Coordinate) {
+  if (blocksToRender.has(block)) {
+    block.updateComponentLocations(blockOrigin);
+    return;
+  }
+  for (const child of block.getChildren(false)) {
+    if (dirtyBlocks.has(child)) {
+      updateComponentLocations(
+        child,
+        Coordinate.sum(blockOrigin, child.relativeCoords),
+      );
+    }
+  }
 }

# libFuzzer dictionary for the text encoders (fuzz_targets/encoders.rs):
# characters and words that string, char, comment, identifier and number
# encoding give meaning to (docs/spec/08-security.md §8.4).

# Quotes, escapes and trigraphs
"\""
"'"
"\\"
"\\\\"
"??"
"???"
"??/"
"??="
"??'"
"??("
"??)"
"??!"
"??<"
"??>"
"??-"
"\\?"
"\\x41"
"\\001"
"\\u202E"
"*/"
"/*"
"//"
"<U+202E>"

# Line terminators, tab and other controls
"\x0a"
"\x0d"
"\x0d\x0a"
"\x09"
"\x0b"
"\x0c"
"\x00"
"\x01"
"\x1f"
"\x7f"
"\xc2\x80"
"\xc2\x85"
"\xc2\x9f"
"\xe2\x80\xa8"
"\xe2\x80\xa9"

# Bidi controls and invisible characters (Trojan Source)
"\xd8\x9c"
"\xe2\x80\x8b"
"\xe2\x80\x8d"
"\xe2\x80\x8e"
"\xe2\x80\x8f"
"\xe2\x80\xaa"
"\xe2\x80\xae"
"\xe2\x81\xa6"
"\xe2\x81\xa9"
"\xe2\x81\xa0"
"\xef\xbb\xbf"
"\xc2\xad"
"\xef\xbf\xbe"
"\xf3\xa0\x80\x81"
"\xf3\xa0\x81\x81"
"\xf4\x8f\xbf\xbf"

# Visible non-ASCII text and whitespace that trimming removes
"\xc3\xa9"
"\xe2\x9c\x93"
"\xc2\xa0"
"\xe3\x80\x80"


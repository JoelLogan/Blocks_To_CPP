# libFuzzer dictionary for fuzz_targets/diag_output.rs: the separator between
# standard error and the SARIF file, then the tokens of the three formats
# (the union of diag_sarif.dict, diag_json.dict and diag_text.dict, since
# libFuzzer takes one dictionary). Seeds are built from
# crates/b2c-toolchain/tests/fixtures/*/ as described in fuzz/README.md.

# Input layout
"\x00sarif\x00"

# JSON structure
"{"
"}"
"["
"]"
"[]"
":"
","
"\""
"\\\""
"\\n"
"\\u2018"
"null"
"true"
"0"
"4294967296"

# SARIF
"\"version\""
"\"2.1.0\""
"\"runs\""
"\"results\""
"\"ruleId\""
"\"level\""
"\"none\""
"\"message\""
"\"text\""
"\"locations\""
"\"relatedLocations\""
"\"physicalLocation\""
"\"artifactLocation\""
"\"uri\""
"\"region\""
"\"startLine\""
"\"startColumn\""
"\"logicalLocations\""
"\"fullyQualifiedName\""
"\"function\""
"file:///"
"%20"

# GCC JSON
"\"kind\""
"\"error\""
"\"warning\""
"\"note\""
"\"fatal error\""
"\"option\""
"\"children\""
"\"caret\""
"\"file\""
"\"line\""
"\"column\""

# Text
"\x0a"
"\x0d\x0a"
":1:1:"
": error: "
": warning: "
": note: "
": fatal error: "
": internal compiler error: "
"[-W"
"[-Werror="
"In file included from "
"                 from "
"In function '"
"In instantiation of '"
"   required from here"
"At global scope"
"\xe2\x80\x98"
"\xe2\x80\x99"
"g++: "
"cc1plus: "
"collect2: error: "
"ld returned 1 exit status"
"/usr/bin/ld: "
": in function `main':"
":(.text+0x1d): "
"undefined reference to "
"multiple definition of "
"cannot find -l"
"compilation terminated."

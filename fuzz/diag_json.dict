# libFuzzer dictionary for fuzz_targets/diag_json.rs: the keys and values of
# GCC's JSON diagnostics (-fdiagnostics-format=json, GCC 10–14), the JSON
# tokens around them and the driver's and linker's text that standard error
# mixes in (docs/spec/07-toolchain-build-run.md §7.5.3).
# Seeds: crates/b2c-toolchain/tests/fixtures/*/*.json.

# JSON structure
"{"
"}"
"["
"]"
"[]"
":"
","
"\""
"\\\""
"\\\\"
"\\n"
"\\u2018"
"\\u0000"
"\\ud800"
"null"
"true"
"false"
"0"
"-1"
"4294967296"
"1e3"
"\x0a["
"\x0a"

# Diagnostic keys and values
"\"kind\""
"\"error\""
"\"warning\""
"\"note\""
"\"fatal error\""
"\"internal compiler error\""
"\"sorry, unimplemented\""
"\"ice\""
"\"message\""
"\"option\""
"\"-Wshadow\""
"\"-Werror=shadow\""
"\"-fpermissive\""
"\"option_url\""
"\"children\""
"\"column-origin\""
"\"escape-source\""
"\"locations\""
"\"caret\""
"\"finish\""
"\"label\""
"\"file\""
"\"line\""
"\"column\""
"\"display-column\""
"\"byte-column\""
"\"src/main.cpp\""

# Text mixed into standard error
": error: "
": note: "
"collect2: error: "
"ld returned 1 exit status"
"/usr/bin/ld: "
": in function `main':"
":(.text+0x1d): "
"undefined reference to "
"g++: fatal error: "
"compilation terminated."

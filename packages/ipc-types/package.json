{
  "name": "@blocks2cpp/ipc-types",
  "version": "0.1.0",
  "private": true,
  "description": "The Blocks2Cpp IPC contract for the frontend: types and a typed client, generated from crates/b2c-ipc",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.12.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}

{
  "name": "@blocks2cpp/b2c-core-wasm",
  "version": "0.1.0",
  "private": true,
  "description": "Blocks2Cpp compiler core for the editor: crates/b2c-core-wasm compiled to WebAssembly, with an embedded-bytes loader",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#glue": {
      "types": "./src/glue.d.ts",
      "default": "./pkg/glue.js"
    },
    "#pkg-bytes": {
      "types": "./src/pkg-bytes.d.ts",
      "default": "./pkg/pkg-bytes.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@blocks2cpp/ipc-types": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}

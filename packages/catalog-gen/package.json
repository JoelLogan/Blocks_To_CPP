{
  "name": "@blocks2cpp/catalog-gen",
  "version": "0.1.0",
  "private": true,
  "description": "Build-time generator: the editor's block definitions and toolbox, and the block reference, from the validated catalog (catalog.json)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "generate": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts write",
    "check": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts check",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
